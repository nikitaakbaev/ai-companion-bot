APP_NAME=AI Companion Bot
APP_ENV=local
DEBUG=true
LOG_LEVEL=INFO
AUTO_CREATE_TABLES=false

TELEGRAM_BOT_TOKEN=

LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=fredrezones55/Qwen3.5-Uncensored-HauhauCS-Aggressive:4b
LLM_TIMEOUT_SECONDS=120
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=800
VISION_MODEL=qwen-vl
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

DATABASE_URL=sqlite+aiosqlite:///./data/bot.db

DEFAULT_CHARACTER_NAME=Kuni
DEFAULT_CHARACTER_DESCRIPTION=AI companion with natural Telegram behavior
DEFAULT_PERSONALITY_STYLE=warm, playful, concise

DEFAULT_PROACTIVE_ENABLED=false
DEFAULT_PROACTIVE_MIN_INTERVAL_MINUTES=60
DEFAULT_PROACTIVE_MAX_INTERVAL_MINUTES=180

MESSAGE_HISTORY_LIMIT=50
MAX_STORED_MESSAGE_LENGTH=8000

VECTOR_STORE_TYPE=chroma
VECTOR_STORE_PATH=./data/chroma
RAG_TOP_K=5
RAG_MIN_SCORE=0.65
MAX_CONTEXT_MESSAGES=20

COMFYUI_BASE_URL=http://127.0.0.1:8188
GENERATED_IMAGES_DIR=./data/generated_images
MEDIA_STORAGE_DIR=./data/media
DIARY_ENABLED=true
DIARY_LOOKBACK_HOURS=24
DIARY_MIN_MESSAGES=3
DIARY_MAX_MESSAGES=100
DIARY_MAX_INPUT_CHARS=20000
DIARY_MAX_ENTRIES_PER_RUN=8
DIARY_REFLECTION_MODEL=
DIARY_SKIP_IF_EXISTS_FOR_DATE=true

PROACTIVE_ENABLED=false
PROACTIVE_MIN_INTERVAL_MINUTES=60
PROACTIVE_MAX_INTERVAL_MINUTES=180
DEFAULT_TIMEZONE=Europe/Moscow

SILENT_HOURS_START=23:00
SILENT_HOURS_END=09:00
